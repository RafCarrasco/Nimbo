{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nimbo",
  "mainBinaryName": "nimbo-app",
  "identifier": "app.nimbo.rust",
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../icon.ico"],
    "publisher": "Nimbo",
    "shortDescription": "Nimbo",
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../icon.ico",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzNDU4MUFDODBGQzEwREEKUldUYUVQeUFySUZGWTR6RFdTazBFV09GY1QwWUlNV3hscTVWM1hmbkl3cjR1ejM5RzlhblBsSTMK",
      "endpoints": ["https://github.com/RafCarrasco/Nimbo/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
